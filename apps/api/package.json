{
  "name": "@api21/api",
  "version": "1.0.0",
  "description": "Modular Express TypeScript REST API server with PostgreSQL (Knex), Redis, BullMQ & Glassmorphic Docs",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && cp -r static dist/",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migrate:latest": "tsx node_modules/knex/bin/cli.js migrate:latest --knexfile src/config/knexfile.ts",
    "migrate:rollback": "tsx node_modules/knex/bin/cli.js migrate:rollback --knexfile src/config/knexfile.ts",
    "migrate:make": "tsx node_modules/knex/bin/cli.js migrate:make --knexfile src/config/knexfile.ts"
  },
  "dependencies": {
    "@api21/types": "workspace:*",
    "@bull-board/api": "^8.6.0",
    "@bull-board/express": "^8.6.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "knex": "^3.3.0",
    "node-pty": "^1.1.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
