{
  "name": "api21-monorepo",
  "version": "1.0.0",
  "description": "Modular Monorepo for api21 (NestJS API, Chat skeleton, Admin skeleton & Shared Types)",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @api21/api dev",
    "dev:api": "pnpm --filter @api21/api dev",
    "dev:worker": "pnpm --filter @api21/api dev:worker",
    "dev:chat": "pnpm --filter @api21/chat dev",
    "dev:admin": "pnpm --filter @api21/admin dev",
    "build": "pnpm --filter @api21/types build && pnpm --filter @api21/pty build && pnpm -r run build",
    "build:api": "pnpm --filter @api21/types build && pnpm --filter @api21/pty build && pnpm --filter @api21/api build",
    "build:chat": "pnpm --filter @api21/types build && pnpm --filter @api21/chat build",
    "build:admin": "pnpm --filter @api21/types build && pnpm --filter @api21/admin build",
    "sentry:sourcemaps": "pnpm --filter @api21/api sentry:sourcemaps",
    "start": "node apps/api/dist/main.js",
    "start:prod": "node apps/api/dist/main.js",
    "start:worker": "node apps/api/dist/worker.js",
    "start:pm2": "npx pm2 start ecosystem.config.cjs --update-env",
    "test": "pnpm --filter @api21/types build && pnpm --filter @api21/pty build && pnpm -r run test",
    "test:api": "pnpm --filter @api21/types build && pnpm --filter @api21/pty build && pnpm --filter @api21/api test",
    "test:admin:e2e": "pnpm --filter @api21/admin test:e2e",
    "migrate:latest": "pnpm --filter @api21/api migrate:latest",
    "migrate:rollback": "pnpm --filter @api21/api migrate:rollback",
    "migrate:make": "pnpm --filter @api21/api migrate:make",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "monorepo",
    "nestjs",
    "typescript",
    "redis",
    "bullmq",
    "postgresql",
    "knex"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@sentry/cli": "^3.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
